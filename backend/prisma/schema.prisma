// CryptoGuard — Prisma schema
// Dev datasource: SQLite (zero-setup). Swap provider to "postgresql" for later stages —
// that's the point of going through Prisma instead of raw queries.
//
// SQLite note: enums are stored as String fields. Valid values are documented in comments
// and enforced at the application layer. When migrating to PostgreSQL, convert to native enums.
//
// Design note on Shadow State isolation (Block E):
// Wallet, Order, and Transaction all carry an `isShadow` flag. Shadow rows are a
// SEPARATE set of records tied to the same user, never a view/filter over the real
// data. This means "can a Shadow session touch authentic state" is a schema-level
// question we can test directly (do writes from a Shadow session ever produce a
// row with isShadow=false?), not just an application-logic promise.
//
// Feature additions (F1–F5):
//   F1: User.phone — required at registration. @default("") is a migration sentinel
//       for existing dev rows; the application layer requires a non-empty value.
//   F2: Session OTP fields + isActive (pending→active gate) + otpAttempts (brute-force lockout).
//   F3: User.normalPinHash / masterPinHash — stored for setup-time distinctness check only;
//       at balance-check time only masterPinHash is read (any non-master input → decoy).
//       PinCheckLog audits outcomes without storing session state.
//   F4: User.role (USER|ADMIN), AdminAccessLog, Session.adminVerifiedAt.
//       Admin views NEVER expose Session.state, RiskEvent, PolicyDecision, or BehavioralEvent —
//       those are enforced via explicit Prisma select{} clauses in admin.routes.ts.
//   F5: WebAuthnCredential table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Identity & Session ----------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  // F1: phone required at registration. @default("") is a migration sentinel for
  //     existing dev rows; auth.routes.ts rejects empty values at the application layer.
  phone         String   @default("")
  passwordHash  String
  displayName   String?
  // F4: RBAC role. USER | ADMIN. Admin seeded via npm run seed (dev-only).
  role          String   @default("USER")  // USER | ADMIN
  // F3: PIN hashes. normalPinHash is ONLY checked at setup time (distinctness enforcement).
  //     At balance-check time, only masterPinHash is compared — any non-master input
  //     returns the decoy wallet. Never read normalPinHash in pin.routes.ts check-balance.
  normalPinHash String?
  masterPinHash String?
  kycStatus     String   @default("PENDING") // PENDING | VERIFIED
  kycDataJson   String?  // JSON snapshot of verified PAN, Aadhaar last4, UPI/bank handles
  kycVerifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            Session[]
  wallets             Wallet[]
  watchlistItems      WatchlistItem[]
  behavioralEvents    BehavioralEvent[]
  // F5:
  webAuthnCredentials WebAuthnCredential[]
  // F4: admin actor side of the log
  adminAccessLogs     AdminAccessLog[]    @relation("AdminActor")
}

// SessionState values: NORMAL | STEP_UP | RESTRICTED | SHADOW

model Session {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  state          String   @default("NORMAL") // SessionState
  tokenHash      String   @unique // hash of the issued JWT/session token, never the raw token
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  // F2: pending→active gate. isActive=false until OTP verified.
  //     requireAuth rejects isActive=false with 401 session_pending.
  isActive       Boolean  @default(false)
  // F2: OTP fields. otpCode stores a bcrypt hash (never plaintext).
  otpCode        String?
  otpExpiresAt   DateTime?
  otpVerified    Boolean  @default(false)
  // F2: brute-force lockout. Incremented before bcrypt compare. >5 → session revoked.
  otpAttempts    Int      @default(0)
  // F4: admin re-verification timestamp. Must be <5 min ago for admin routes.
  adminVerifiedAt DateTime?

  behavioralEvents BehavioralEvent[]
  riskEvents       RiskEvent[]
  policyDecisions  PolicyDecision[]
  // F3:
  pinCheckLogs     PinCheckLog[]

  @@index([userId])
  @@index([state])
}

// ---------- ARES: behavioral signal capture ----------

model BehavioralEvent {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  dwellTimeMs    Float? // avg key hold duration
  flightTimeMs   Float? // avg time between keystrokes
  typingSpeedCpm Float? // characters per minute
  correctionRate Float? // backspace/delete ratio
  contextJson    String? // JSON blob: device, geo-coarse, time-of-day, navigation pattern, etc.
  capturedAt     DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

// ---------- ARES: risk scoring output ----------

// RiskModel values: BASELINE_RULE | ML_MODEL | NEURAL_NET

model RiskEvent {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  modelUsed    String   // RiskModel: BASELINE_RULE | ML_MODEL
  riskScore    Float    // 0..1, higher = riskier
  trustScore   Float    // 0..1, higher = more trusted
  confidence   Float    // 0..1, model's confidence in this estimate
  signalsJson  String   // snapshot of the feature vector used, for auditability
  decision     String   // SessionState: recommended state per Policy Engine thresholds
  createdAt    DateTime @default(now())

  policyDecisions PolicyDecision[]

  @@index([sessionId])
}

// ---------- Policy Engine: state transitions ----------

model PolicyDecision {
  id          String     @id @default(uuid())
  sessionId   String
  session     Session    @relation(fields: [sessionId], references: [id])
  riskEventId String?
  riskEvent   RiskEvent? @relation(fields: [riskEventId], references: [id])
  fromState   String     // SessionState
  toState     String     // SessionState
  reason      String     // human-readable justification, e.g. "riskScore 0.82 > shadowThreshold 0.75"
  createdAt   DateTime   @default(now())

  @@index([sessionId])
}

// ---------- Wallet / Trading (real + shadow, isolated by isShadow flag) ----------

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isShadow  Boolean  @default(false)
  address   String   @unique // synthetic devnet address
  chain     String   @default("devnet")
  createdAt DateTime @default(now())

  holdings     Holding[]
  orders       Order[]
  transactions Transaction[]

  @@index([userId])
  @@index([isShadow])
}

model Holding {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id])
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([walletId, coinId])
}

// OrderSide values: BUY | SELL
// OrderType values: MARKET | LIMIT
// OrderStatus values: OPEN | FILLED | CANCELLED

model Order {
  id         String   @id @default(uuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id])
  coinId     String
  coin       Coin     @relation(fields: [coinId], references: [id])
  side       String   // OrderSide: BUY | SELL
  type       String   // OrderType: MARKET | LIMIT | STOP_LIMIT
  quantity   Float
  limitPrice Float?   // null for MARKET orders
  stopPrice  Float?   // trigger price for STOP_LIMIT orders
  fillPrice  Float?
  status     String   @default("OPEN") // OrderStatus: OPEN | FILLED | CANCELLED
  isShadow   Boolean  @default(false) // denormalized from wallet for fast isolation checks/queries
  createdAt  DateTime @default(now())
  filledAt   DateTime?

  transactions Transaction[]

  @@index([walletId])
  @@index([isShadow])
}

// TransactionType values: BUY | SELL | DEPOSIT | WITHDRAWAL

model Transaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id])
  type      String   // TransactionType: BUY | SELL | DEPOSIT | WITHDRAWAL
  amount    Float
  priceUsd  Float
  isShadow  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([isShadow])
}

// ---------- Market data cache ----------

model Coin {
  id              String   @id @default(uuid())
  symbol          String   @unique
  name            String
  priceUsd        Float
  marketCapUsd    Float?
  volume24hUsd    Float?
  change24hPct    Float?
  logoUrl         String?
  rank            Int?     // market cap rank, for sorting/trending
  isTrending      Boolean  @default(false)
  priceHistory7d  String?  // JSON: array of { timestamp, price } for 7-day chart
  lastUpdatedAt   DateTime @default(now())

  holdings       Holding[]
  orders         Order[]
  transactions   Transaction[]
  watchlistItems WatchlistItem[]
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, coinId])
}

// ---------- F5: WebAuthn credentials ----------
// Stores public-key credentials registered by the user via navigator.credentials.
// publicKey is stored as base64. counter is incremented on each authentication
// to detect cloned authenticators (replay protection).

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  credentialId String   @unique
  publicKey    String   // base64-encoded public key
  counter      Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ---------- F4: Admin access audit log ----------
// Written BEFORE data is fetched (crash mid-request still leaves a record).
// viewedUserId is null for list views.
// IMPORTANT: this table must never reference Session.state, RiskEvent, or
// PolicyDecision — it is an access audit only, not a behavioral audit.

model AdminAccessLog {
  id           String   @id @default(uuid())
  adminUserId  String
  adminUser    User     @relation("AdminActor", fields: [adminUserId], references: [id])
  viewedUserId String?  // null for list actions
  action       String   // e.g. "list_users" | "view_user" | "view_logs"
  timestamp    DateTime @default(now())

  @@index([adminUserId])
  @@index([timestamp])
}

// ---------- F3: PIN check audit log ----------
// Records the outcome of each /api/pin/check-balance call for auditability.
// outcome values: shadow_bypass | normal_master | normal_decoy
// Does NOT store the PIN itself, the session state, or any ARES output.

model PinCheckLog {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  outcome   String   // shadow_bypass | normal_master | normal_decoy
  createdAt DateTime @default(now())

  @@index([sessionId])
}
