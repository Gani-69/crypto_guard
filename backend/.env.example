PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-dev-only"
JWT_EXPIRES_IN="1h"
MARKET_DATA_PROVIDER="coingecko"
MARKET_DATA_API_KEY=""

# F2: SMTP config for OTP email delivery (optional — omit to log codes to console in dev)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS="your-password"
# SMTP_FROM="noreply@cryptoguard.dev"

# Resend API & OTP Test Override (optional - routes @cryptoguard.dev test emails to a verified inbox)
# RESEND_API_KEY=""
# OTP_TEST_OVERRIDE_EMAIL=""

# Seed configuration (optional - phone number for seeded accounts)
# SEED_TEST_PHONE=""

# F5: WebAuthn Relying Party (must match the browser origin)
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_RP_NAME="CryptoGuard"
# WEBAUTHN_ORIGIN="http://localhost:5173"
